{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node .github/scripts/build-site.mjs",
  "outputDirectory": "_site",
  "installCommand": "echo sin dependencias",
  "framework": null,
  "trailingSlash": true,
  "redirects": [{ "source": "/", "destination": "/biblioteca/", "permanent": false }],
  "headers": [
    {
      "source": "/(.*)\\.(webp|png|woff2)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/biblioteca/(llms\\.txt|llms-full\\.txt)",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/biblioteca/md/(.*)\\.md",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    }
  ]
}
